manifest {
    nextflowVersion = '!>=24.10.6'
}

// -----------------------------------------------------------------------------
// Public parameters. Names and flat structure are retained for CLI compatibility.
// -----------------------------------------------------------------------------
params {
    // Inputs, routing, and output identity
    bam = null
    vcf = null
    annovar_txt = null
    annotated_snv = "no"
    annotated_sv = "no"
    annovar_sv_vcf = null
    pipeline_version = "0.5.0"
    out_prefix = "PipeVar"
    hpo = null
    light = null
    ref_fa = null

    // SNV/SV prioritization and inheritance
    gnomad_af_ad = "0.001"
    gnomad_af_ar = "0.01"
    inheritance_mode = "ml"
    include_clinvar_report = "yes"
    allow_unphased_comphet = "no"
    prioritize_sv_only = "no"
    rankscore = "0.50"
    rankscore_softwares = null
    rankvar = "0.05"
    phenosv_score = "0.50"
    common_sv_filter = "yes"
    common_sv_af = null
    common_sv_af_ad = null
    common_sv_af_ar = null
    common_sv_reciprocal_overlap = "0.5"
    common_sv_distance = "1000"
    common_sv_ins_distance = "500"
    common_sv_ins_identity = "0.5"

    // Genotype and caller quality controls
    gq = "20"
    ad = "15"
    nanocaller_dp = "20"
    mode = null

    // Sequencing and calling controls
    type = "ont"
    help = false
    input_directory = null
    output_directory = launchDir
    gene = null
    note = null
    input_csv = null
    phen2gene_filter = 500
    genome = "hg38"
    expansionhunter_variant_catalog = null
    target = null
    targeted = null  // legacy alias retained for CLI compatibility
    cnvnator = "yes"
    cnvnator_bin_size = 100
    truvari_shortread_refdist = 1000
    truvari_shortread_pctseq = 0
    truvari_shortread_pctsize = 0.5
    truvari_shortread_pctovl = 0.5
    truvari_shortread_sizemin = 50
    truvari_shortread_keep = "first"
    xtea = "no"

    // Mitochondrial analysis
    mito = "no"
    mito_contig = "chrM"
    mito_min_vaf = "0.01"
    mito_min_depth = "50"
    mito_min_alt_reads = "5"
    mito_gui_min_af = "0.5"
    mito_gui_min_apogee2 = "0.5"
    mito_gui_min_mitotip = "12.66"
    hmtvar_data = null
    annovar_host_path = "${projectDir}/annovar"
    phenosv_host_path = "${projectDir}/PhenoSV_model"

    // Runtime, GPU, and phenotype extraction
    GPU = "no"
    gpu_backend = "singularity"
    gpu_cpus = 16
    gpu_cluster_options = "--gres=gpu:1"
    deepvariant_version = "1.9.0"
    deepvariant_max_forks = null
    phenotype_extractor = "phenotagger"
    phenogpt2_batch_size = 1
    phenogpt2_chunk_batch_size = 1
    phenogpt2_wc = 0
    phenogpt2_attn_implementation = "eager"
    phenogpt2_negation = "no"
    phenogpt2_max_forks = 1
    phenogpt2_sif = null
    phenotagger_sif = null
    phenogpt2_model_host_path = null
    phenogpt2_negation_model_host_path = null
    phenogpt2_embedding_model_host_path = null
    phenogpt2_cache_host_path = null

}

// -----------------------------------------------------------------------------
// Tool-mode policy. Single and batch implementations share each selector.
// -----------------------------------------------------------------------------
process {
    withName:'phenotagger' {
        container = {
            def supplied = params.phenotagger_sif?.toString()?.trim()
            def engine = workflow.containerEngine?.toString()?.trim()?.toLowerCase()
            supplied && engine in ['singularity', 'apptainer'] ?
                new File(supplied).canonicalFile.toPath().toUri().toString() :
                'beoungl/docker_test:phenotagger'
        }
    }
    withName:'phenogpt2' {
        container = {
            def supplied = params.phenogpt2_sif?.toString()?.trim()
            def engine = workflow.containerEngine?.toString()?.trim()?.toLowerCase()
            supplied && engine in ['singularity', 'apptainer'] ?
                new File(supplied).canonicalFile.toPath().toUri().toString() :
                'beoungl/docker_test:phenogpt2_0.4'
        }
    }
    withName:'phenosv' {
        ext.args = { (params.light ? params.light.toString().trim().toLowerCase() : 'no') == 'yes' ? '--model PhenoSV-light ' : '' }
    }
    withName:'nanocaller' {
        ext.args = {
            def type = params.type ? params.type.toString().trim().toLowerCase() : 'ont'
            type == 'ont' ? '--preset ont' : type == 'pacbio' ? '--preset ccs' : ''
        }
    }
    withName:'clair3|mito_clair3' {
        ext.args = {
            def type = params.type ? params.type.toString().trim().toLowerCase() : 'ont'
            type == 'ont' ? '--platform="ont" --model_path="/opt/models/ont"' : type == 'pacbio' ? '--platform="hifi" --model_path="/opt/models/hifi"' : ''
        }
    }
    withName:'nanorepeat' {
        ext.args = {
            def type = params.type ? params.type.toString().trim().toLowerCase() : 'ont'
            type == 'ont' ? 'ont' : type == 'pacbio' ? 'hifi' : ''
        }
    }
    withName:'LONGPHASE_CALL' {
        ext.args = {
            def type = params.type ? params.type.toString().trim().toLowerCase() : 'ont'
            type == 'ont' ? '--ont' : type == 'pacbio' ? '--pb' : ''
        }
    }
}



// -----------------------------------------------------------------------------
// Central process resources, retries, publication, and tool-specific arguments
// -----------------------------------------------------------------------------
process {
    // Retry resource/executor terminations. Deterministic tool and input
    // failures stop immediately with their original diagnostic.
    errorStrategy = { task.exitStatus in [137, 140, 143] ? 'retry' : 'terminate' }
    maxRetries = 2

    withName: 'nanocaller' {
        cpus   = { 8 * task.attempt }
        memory = { 32.GB * task.attempt }
        time   = { 48.h }
        publishDir = [
            path: { "${params.output_directory}" }
        ]
    }

    withName: 'phenosv' {
        containerOptions = {
            def directory = new File(params.phenosv_host_path.toString()).canonicalFile
            if (!directory.isDirectory()) {
                throw new IllegalArgumentException("Container resource directory does not exist: ${directory} (mounted at /PhenoSV/train_data)")
            }
            def option = params.gpu_backend.toString().trim().toLowerCase() == 'docker' ? '-v' : '--bind'
            def mount = "${directory}:/PhenoSV/train_data:rw".replace("'", "'\"'\"'")
            "${option} '${mount}'"
        }
        cpus   = { 1 * task.attempt }
        memory = { 8.GB * task.attempt }
        time   = { 48.h }
        publishDir = [
            path: { "${params.output_directory}" },
            mode: 'copy'
        ]

    }

    withName: 'annovar' {
        containerOptions = {
            def directory = new File(params.annovar_host_path.toString()).canonicalFile
            if (!directory.isDirectory()) {
                throw new IllegalArgumentException("Container resource directory does not exist: ${directory} (mounted at /annovar)")
            }
            def option = params.gpu_backend.toString().trim().toLowerCase() == 'docker' ? '-v' : '--bind'
            def mount = "${directory}:/annovar:rw".replace("'", "'\"'\"'")
            "${option} '${mount}'"
        }
        cpus   = { 2 * task.attempt }
        memory = { 16.GB * task.attempt }
        time   = { 24.h }
        publishDir = [
            path: { "${params.output_directory}" },
            pattern: "*{txt}"
        ]
    }

    withName: 'phen2gene' {
        cpus   = { 1 * task.attempt }
        memory = { 4.GB * task.attempt }
        time   = { 4.h }
        publishDir = [
            path: { "${params.output_directory}" }
        ]
    }

    withName: 'clair3' {
        cpus   = { 8 * task.attempt }
        memory = { 32.GB * task.attempt }
        time   = { 72.h }
        publishDir = [
            path: { "${params.output_directory}" }
        ]

    }
    withName: 'mito_clair3' {
        cpus   = { 2 * task.attempt }
        memory = { 8.GB * task.attempt }
        time   = { 8.h }
        publishDir = [
            path: { "${params.output_directory}" }
        ]

    }
    withName: 'mito_clair3_postprocess' {
        cpus   = { 1 * task.attempt }
        memory = { 4.GB * task.attempt }
        time   = { 4.h }
        publishDir = [
            path: { "${params.output_directory}" }
        ]

    }
    withName: 'nanorepeat' {
        cpus   = { 2 * task.attempt }
        memory = { 16.GB * task.attempt }
        time   = { 72.h }
        publishDir = [
            path: { "${params.output_directory}" }
        ]
    }

    withName: 'rankvar' {
        cpus   = { 1 * task.attempt }
        memory = { 8.GB * task.attempt }
        time   = { 8.h }
        publishDir = [
            path: { "${params.output_directory}" },
            mode: 'copy'
        ]
    }

    withName: 'SNIFFLES' {
        cpus   = { 2 * task.attempt }
        memory = { 16.GB * task.attempt }
        time   = { 24.h }
        ext.prefix = { "${meta.id}.sniffles" }
        ext.args = '--allow-overwrite --output-rnames'
    }

    withName: 'survivor' {
        cpus   = { 1 * task.attempt }
        memory = { 4.GB * task.attempt }
        time   = { 2.h }
        publishDir = [
            path: { "${params.output_directory}" }
        ]
    }

    withName: 'MANTA_GERMLINE' {
        cpus   = { 4 * task.attempt }
        memory = { 32.GB * task.attempt }
        time   = { 48.h }
        ext.prefix = { "${meta.id}.manta" }
    }

    withName: 'normalize_shortread_alignment' {
        cpus   = { 2 * task.attempt }
        memory = { 8.GB * task.attempt }
        time   = { 24.h }
    }

    withName: 'cnvnator' {
        cpus   = { 2 * task.attempt }
        memory = { 32.GB * task.attempt }
        time   = { 72.h }
        publishDir = [
            path: { "${params.output_directory}" },
            pattern: "*_cnvnator.{tab,vcf}"
        ]
    }

    withName: 'xtea' {
        cpus   = { 8 * task.attempt }
        memory = { 32.GB * task.attempt }
        time   = { 72.h }
        publishDir = [
            path: { "${params.output_directory}" },
            pattern: "*_xtea*"
        ]
    }

    withName: 'truvari_shortread_sv_merge' {
        cpus   = { 1 * task.attempt }
        memory = { 8.GB * task.attempt }
        time   = { 8.h }
        ext.args = "--refdist ${params.truvari_shortread_refdist} --pctseq ${params.truvari_shortread_pctseq} --pctsize ${params.truvari_shortread_pctsize} --pctovl ${params.truvari_shortread_pctovl} --sizemin ${params.truvari_shortread_sizemin} --keep ${params.truvari_shortread_keep}"
        publishDir = [
            path: { "${params.output_directory}" },
            pattern: "*.shortread_sv*.vcf",
            mode: 'copy'
        ]
    }

    withName: 'GATK4_HAPLOTYPECALLER' {
        cpus   = { 2 * task.attempt }
        memory = { 16.GB * task.attempt }
        time   = { 48.h }
        container = 'broadinstitute/gatk:4.5.0.0'
        ext.prefix = { "${meta.id}" }
    }

    withName: 'GATK4_VARIANTRECALIBRATOR' {
        cpus   = { 2 * task.attempt }
        memory = { 16.GB * task.attempt }
        time   = { 48.h }
        container = 'broadinstitute/gatk:4.5.0.0'
        ext.prefix = { "${meta.id}" }
        ext.args = '-an QD -an MQ -an MQRankSum -an ReadPosRankSum -an FS -an SOR -mode SNP'
    }

    withName: 'GATK4_APPLYVQSR' {
        cpus   = { 2 * task.attempt }
        memory = { 16.GB * task.attempt }
        time   = { 48.h }
        container = 'broadinstitute/gatk:4.5.0.0'
        ext.prefix = { "${meta.id}.recal" }
        ext.args = '--ts-filter-level 99.0 -mode SNP'
        publishDir = [
            path: { "${params.output_directory}" },
            pattern: '*.recal.vcf.gz'
        ]
    }

    withName: 'DEEPVARIANT_RUNDEEPVARIANT' {
        cpus   = { (params.GPU ? params.GPU.toString().trim().toLowerCase() : 'no') == 'yes' ? params.gpu_cpus as int : 16 * task.attempt }
        memory = { 64.GB * task.attempt }
        time   = { 72.h }
        maxForks = params.deepvariant_max_forks ? params.deepvariant_max_forks as int : 1000000
        container = { "google/deepvariant:${params.get('deepvariant_version', '1.9.0')}${(params.GPU ? params.GPU.toString().trim().toLowerCase() : 'no') == 'yes' ? '-gpu' : ''}" }
        ext.prefix = { "${meta.id}.deepvariant" }
        ext.args = '--model_type=WGS'
        publishDir = [
            path: { "${params.output_directory}" },
            pattern: '*.deepvariant.vcf.gz'
        ]
    }

    withName: 'annovar_sv' {
        containerOptions = {
            def directory = new File(params.annovar_host_path.toString()).canonicalFile
            if (!directory.isDirectory()) {
                throw new IllegalArgumentException("Container resource directory does not exist: ${directory} (mounted at /annovar)")
            }
            def option = params.gpu_backend.toString().trim().toLowerCase() == 'docker' ? '-v' : '--bind'
            def mount = "${directory}:/annovar:rw".replace("'", "'\"'\"'")
            "${option} '${mount}'"
        }
        cpus   = { 1 * task.attempt }
        memory = { 4.GB * task.attempt }
        time   = { 8.h }
        publishDir = [
            path: { "${params.output_directory}" }
        ]
    }

    withName: 'common_sv_filter' {
        cpus   = { 1 * task.attempt }
        memory = { 4.GB * task.attempt }
        time   = { 4.h }
        publishDir = [
            path: { "${params.output_directory}" },
            pattern: "*.common_sv_*",
            mode: 'copy'
        ]
    }

    withName: 'EXPANSIONHUNTER' {
        cpus   = { 2 * task.attempt }
        memory = { 16.GB * task.attempt }
        time   = { 12.h }
        ext.prefix = { "${meta.id}" }
    }

    withName: 'MATERIALIZE_PUBLIC_ARTIFACT|MANTA_PUBLIC_ARTIFACT|EXPANSIONHUNTER_PUBLIC_ARTIFACT' {
        cpus   = { 1 * task.attempt }
        memory = { 1.GB * task.attempt }
        time   = { 1.h }
        container = 'community.wave.seqera.io/library/htslib_samtools:1.23.1--5b6bb4ede7e612e5'
        publishDir = [
            path: { "${params.output_directory}" },
            pattern: '*.{json,vcf}'
        ]
    }

    // Preserve the historical LongPhase resource envelope across calling and prioritization.
    withName: 'LONGPHASE_CALL|LONGPHASE_PRIORITIZE' {
        cpus   = { 4 * task.attempt }
        memory = { 32.GB * task.attempt }
        time   = { 24.h }
    }

    withName: 'LONGPHASE_CALL' {
        publishDir = [
            path: { "${params.output_directory}" },
            pattern: '*_haplotag.bam',
            mode: 'copy',
            enabled: { meta.batch_input }
        ]
    }

    withName: 'LONGPHASE_PRIORITIZE' {
        publishDir = [
            path: { "${params.output_directory}" },
            mode: 'copy'
        ]
    }

    // Terminal prioritization outputs can be moved out of work after successful publication.
    withName: 'ngs_prio|small_variant_prio|sv_prio' {
        cpus   = { 1 * task.attempt }
        memory = { 8.GB * task.attempt }
        time   = { 8.h }
        publishDir = [
            path: { "${params.output_directory}" },
            mode: 'copy'
        ]
    }

    withName: 'variant_html_report_no_repeat|variant_html_report_with_repeat|variant_html_report_with_repeat_and_mito' {
        cpus   = { 1 * task.attempt }
        memory = { 4.GB * task.attempt }
        time   = { 2.h }
        publishDir = [
            path: { "${params.output_directory}" },
            mode: 'copy'
        ]
    }

    // Build targeted BED intervals from phenotype-ranked genes.
    withName: 'reduce_region_phen2gene' {
        cpus   = { 1 * task.attempt }
        memory = { 4.GB * task.attempt }
        time   = { 2.h }
        publishDir = [
            path: { "${params.output_directory}" }
        ]
    }

    // Download and validate one shared GATK VQSR bundle per run.
    withName: 'GATK_RESOURCE_BUNDLE' {
        cpus   = { 1 * task.attempt }
        memory = { 8.GB * task.attempt }
        time   = { 24.h }
        errorStrategy = 'retry'
        maxRetries = 3
    }

    withName: 'eh_filter' {
        cpus   = { 1 * task.attempt }
        memory = { 4.GB * task.attempt }
        time   = { 1.h }
        publishDir = [
            path: { "${params.output_directory}" }
        ]
    }

    withName: 'mito_prep_mutect2' {
        cpus   = { 4 * task.attempt }
        memory = { 8.GB * task.attempt }
        time   = { 8.h }
        publishDir = [
            path: { "${params.output_directory}" },
            pattern: "*.mito.dup_metrics.txt",
            mode: 'copy'
        ]
    }

    withName: 'mito_mutect2' {
        cpus   = { 1 * task.attempt }
        memory = { 8.GB * task.attempt }
        time   = { 4.h }
        publishDir = [
            path: { "${params.output_directory}" }
        ]
    }

    withName: 'mito_annotation' {
        cpus   = { 1 * task.attempt }
        memory = { 4.GB * task.attempt }
        time   = { 2.h }
        publishDir = [
            path: { "${params.output_directory}" },
            mode: 'copy'
        ]
    }

    withName: 'mito_prio' {
        cpus   = { 1 * task.attempt }
        memory = { 4.GB * task.attempt }
        time   = { 2.h }
        publishDir = [
            path: { "${params.output_directory}" },
            mode: 'copy'
        ]
    }

    withName: 'rankscore|rankscore_preannotated' {
        cpus   = { 1 * task.attempt }
        memory = { 8.GB * task.attempt }
        time   = { 4.h }
        publishDir = [
            path: { "${params.output_directory}" },
            mode: 'copy'
        ]
    }

    withName: 'phenotagger' {
        cpus   = { 1 * task.attempt }
        memory = { 8.GB * task.attempt }
        time   = { 4.h }
        publishDir = [
            path: { "${params.output_directory}" }
        ]
    }

    withName: 'phenogpt2' {
        cpus   = { params.gpu_cpus as int }
        memory = { 64.GB * task.attempt }
        time   = { 12.h }
        maxForks = params.phenogpt2_max_forks ? params.phenogpt2_max_forks as int : 1
        publishDir = [
            path: { "${params.output_directory}" }
        ]
    }
}

process {
    withName: 'DEEPVARIANT_RUNDEEPVARIANT' {
        containerOptions = {
            def gpu = params.GPU ? params.GPU.toString().trim().toLowerCase() : 'no'
            def backend = params.gpu_backend ? params.gpu_backend.toString().trim().toLowerCase() : 'singularity'
            gpu == 'yes' ? (backend == 'docker' ? '--gpus 1' : '--nv') : ''
        }
        clusterOptions = { (params.GPU ? params.GPU.toString().trim().toLowerCase() : 'no') == 'yes' && params.gpu_cluster_options ? params.gpu_cluster_options.toString() : '' }
    }
    withName: 'phenogpt2' {
        containerOptions = {
            def gpu = params.GPU ? params.GPU.toString().trim().toLowerCase() : 'no'
            if (gpu != 'yes') {
                return ''
            }
            def backend = params.gpu_backend ? params.gpu_backend.toString().trim().toLowerCase() : 'singularity'
            def option = backend == 'docker' ? '-v' : '--bind'
            def options = backend == 'docker' ? '--gpus 1' : '--nv'
            if (params.phenogpt2_model_host_path) {
                def modelDirectory = new File(params.phenogpt2_model_host_path.toString()).canonicalFile
                if (!modelDirectory.isDirectory()) {
                    throw new IllegalArgumentException("Container resource directory does not exist: ${modelDirectory} (mounted at /opt/phenogpt2/models/phenogpt2)")
                }
                def modelMount = "${modelDirectory}:/opt/phenogpt2/models/phenogpt2:ro".replace("'", "'\"'\"'")
                options += " ${option} '${modelMount}'"
                if (params.phenogpt2_negation.toString().trim().toLowerCase() == 'yes') {
                    def negationDirectory = new File(params.phenogpt2_negation_model_host_path.toString()).canonicalFile
                    if (!negationDirectory.isDirectory()) {
                        throw new IllegalArgumentException("Container resource directory does not exist: ${negationDirectory} (mounted at /opt/phenogpt2/models/negation)")
                    }
                    def negationMount = "${negationDirectory}:/opt/phenogpt2/models/negation:ro".replace("'", "'\"'\"'")
                    options += " ${option} '${negationMount}'"
                    def embeddingDirectory = new File(params.phenogpt2_embedding_model_host_path.toString()).canonicalFile
                    if (!embeddingDirectory.isDirectory()) {
                        throw new IllegalArgumentException("Container resource directory does not exist: ${embeddingDirectory} (mounted at /opt/phenogpt2/models/embedding)")
                    }
                    def embeddingMount = "${embeddingDirectory}:/opt/phenogpt2/models/embedding:ro".replace("'", "'\"'\"'")
                    options += " ${option} '${embeddingMount}'"
                }
                if (params.phenogpt2_cache_host_path) {
                    def cacheDirectory = new File(params.phenogpt2_cache_host_path.toString()).canonicalFile
                    if (!cacheDirectory.isDirectory()) {
                        throw new IllegalArgumentException("Container resource directory does not exist: ${cacheDirectory} (mounted at /opt/phenogpt2/cache)")
                    }
                    def cacheMount = "${cacheDirectory}:/opt/phenogpt2/cache:rw".replace("'", "'\"'\"'")
                    options += " ${option} '${cacheMount}'"
                }
            }
            options
        }
        clusterOptions = { (params.GPU ? params.GPU.toString().trim().toLowerCase() : 'no') == 'yes' && params.gpu_cluster_options ? params.gpu_cluster_options.toString() : '' }
    }
}

// Large Docker-to-SIF conversions can exceed Nextflow's 20-minute default.
// Keep this outside profiles.standard because setup helpers rewrite that block.
singularity {
    pullTimeout = '2h'
}


// -----------------------------------------------------------------------------
// Execution profiles. Kept explicit because setup helpers rewrite standard.
// -----------------------------------------------------------------------------
profiles {
    // Default behavior: SLURM executor with Singularity containers.
    standard {
        params.gpu_backend = 'singularity'
        process.executor = 'slurm'
        singularity.enabled = true
        singularity.autoMounts = true
        docker.enabled = false
    }

    // Explicit SLURM + Singularity profile (same backend as standard).
    slurm_singularity {
        params.gpu_backend = 'singularity'
        process.executor = 'slurm'
        singularity.enabled = true
        singularity.autoMounts = true
        docker.enabled = false
    }

    // Local executor while still using Singularity images.
    local_singularity {
        params.gpu_backend = 'singularity'
        process.executor = 'local'
        singularity.enabled = true
        singularity.autoMounts = true
        docker.enabled = false
    }

    // Local executor with Docker containers.
    local_docker {
        params.gpu_backend = 'docker'
        process.executor = 'local'
        docker.enabled = true
        singularity.enabled = false
    }
}

report {
    enabled=true
}

trace {
    enabled=true
}
