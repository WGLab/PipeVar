params {
	bam = null
	vcf = null
	pipeline_version = "0.3.0"
	out_prefix = "PipeVar"
	hpo = null
	light = null
	ref_fa = null
	gnomad = "0.0001"
	inheritance_mode = "ml"
	include_clinvar_report = "yes"
	allow_unphased_comphet = "no"
	rankscore = "0.50"
	rankvar = "0.05"
	gq = "20"
	ad = "15"
	mode = null
	type = "ont"
	help = false
	input_directory = null
	output_directory = launchDir
	gene = null
	note = null
	input_csv = null
	phen2gene_filter = 500
	genome = "hg38"
	target = null
	annovar_host_path = "${projectDir}/annovar"
	phenosv_host_path = "${projectDir}/PhenoSV_model"

}
if (params.light == 'yes') {
	process {
		withName:'PhenoSV'{
			ext.args='--model PhenoSV-light '
		}
	}
	process {
		withName:'multi_phenosv'{
			ext.args='--model PhenoSV-light '
		}
	}
}

if (params.type == 'ont') {
	process {
		withName:'nanocaller'{
			ext.args='--preset ont'
		}
	}
	process {
		withName:'multi_nanocaller'{
			ext.args='--preset ont'
		}
	}
	process {
		withName:'clair3'{
			ext.args='--platform="ont" --model_path="/opt/models/ont"'
		}
	}
	process {
                withName:'multi_clair3'{
                        ext.args='--platform="ont" --model_path="/opt/models/ont"'
                }
        }
	process {
		withName:'cuteSV'{
			ext.args='--max_cluster_bias_INS 100 --diff_ratio_merging_INS 0.3 --max_cluster_bias_DEL 100 --diff_ratio_merging_DEL 0.3'
		}
	}
	process {
		withName:'NanoRepeat'{
			ext.args='ont'
		}
	}
	process {
                withName:'multi_nanorepeat'{
                        ext.args='ont'
                }
        }
}


if (params.genome == 'grch38') {
        process {
                withName:'ExpansionHunter|multi_expansionhunter'{
                        ext.args='/EH_grch38/variant_catalog.json'
                }
        }
}

if (params.genome == 'hg38') {
        process {
                withName:'ExpansionHunter|multi_expansionhunter'{
                        ext.args='/hg38/variant_catalog.json'
                }
        }
}





if (params.type == 'pacbio' ) {
        process {
                withName:'nanocaller'{
			ext.args='--preset ccs'
        	}
	}
	process {
		withName:'multi_nanocaller'{
			ext.args='--preset ccs'
		}
	}
        process {
                withName:'clair3'{
			ext.args='--platform="ont" --model_path="/opt/models/hifi"'
        	}
	}
	process {
                withName:'multi_clair3'{
                        ext.args='--platform="ont" --model_path="/opt/models/hifi"'
                }
        }
        process {
                withName:'cuteSV'{
			ext.args='--max_cluster_bias_INS 1000 --diff_ratio_merging_INS 0.9 --max_cluster_bias_DEL 1000 --diff_ratio_merging_DEL	0.5'
        	}
	}
	process {
		withName:'NanoRepeat'{
			ext.args='hifi'
		}
	}
	process {
                withName:'multi_nanorepeat'{
                        ext.args='hifi'
                }
        }

}



process {
    errorStrategy = 'retry'
    maxRetries = 3

    // Combine 'nanocaller' and 'multi_nanocaller'
    withName: 'nanocaller|multi_nanocaller' {
        cpus   = { 2 * task.attempt }
        memory = { 16.GB * task.attempt }
        time   = { 48.h }
        publishDir = [
            path: { "${params.output_directory}" }
        ]
    }

    withName: 'PhenoSV|multi_phenosv' {
        cpus   = { 1 * task.attempt }
        memory = { 8.GB * task.attempt }
        time   = { 48.h }
        publishDir = [
            path: { "${params.output_directory}" },
            mode: 'copy'
        ]

    }

    withName: 'ANNOVAR|multi_annovar' {
        cpus   = { 1 * task.attempt }
        memory = { 8.GB * task.attempt }
        time   = { 24.h }
        publishDir = [
            path: { "${params.output_directory}" },
            pattern: "*{txt}"
        ]
    }

    withName: 'Phen2gene|multi_phen2gene' {
        cpus   = { 1 * task.attempt }
        memory = { 8.GB * task.attempt }
        time   = { 24.h }
        publishDir = [
            path: { "${params.output_directory}" }
        ]
    }

    withName: 'clair3|multi_clair3' {
        cpus   = { 2 * task.attempt }
        memory = { 16.GB * task.attempt }
        time   = { 72.h }
        publishDir = [
            path: { "${params.output_directory}" }
        ]

    }
    withName: 'NanoRepeat|multi_nanorepeat' {
        cpus   = { 2 * task.attempt }
        memory = { 16.GB * task.attempt }
        time   = { 72.h }
        publishDir = [
            path: { "${params.output_directory}" }
        ]
    }

    withName: 'RankVar|multi_rankvar' {
        cpus   = { 2 * task.attempt }
        memory = { 16.GB * task.attempt }
        publishDir = [
            path: { "${params.output_directory}" },
            mode: 'copy'
        ]
    }

    withName: 'sniffles|multi_sniffles' {
        cpus   = { 2 * task.attempt }
        memory = { 16.GB * task.attempt }
        publishDir = [
            path: { "${params.output_directory}" }
        ]

    }

    withName: 'SURVIVOR|multi_survivor' {
        cpus   = { 1 * task.attempt }
        memory = { 4.GB * task.attempt }
        publishDir = [
            path: { "${params.output_directory}" }
        ]
    }

    withName: 'truvari' {
        cpus   = { 1 * task.attempt }
        memory = { 4.GB * task.attempt }
        publishDir = [
            path: { "${params.output_directory}" }
        ]
    }

    withName: 'cuteSV' {
        cpus   = { 2 * task.attempt }
        memory = { 16.GB * task.attempt }
        publishDir = [
            path: { "${params.output_directory}" }
        ]
    }

    withName: 'Manta|multi_manta' {
        cpus   = { 2 * task.attempt }
        memory = { 16.GB * task.attempt }
        publishDir = [
            path: { "${params.output_directory}" }
        ]
    }

    withName: 'haplotypecaller|multi_haplotypecaller' {
        cpus   = { 2 * task.attempt }
        memory = { 16.GB * task.attempt }
        time   = { 48.h }
        publishDir = [
            path: { "${params.output_directory}" }
        ]
    }

    withName: 'deepvariant|multi_deepvariant' {
        cpus   = { 2 * task.attempt }
        memory = { 16.GB * task.attempt }
        time   = { 72.h }
        publishDir = [
            path: { "${params.output_directory}" }
        ]
    }

    withName: 'ANNOVAR_SV|multi_annovar_sv' {
        cpus   = { 1 * task.attempt }
        memory = { 4.GB * task.attempt }
        publishDir = [
            path: { "${params.output_directory}" }
        ]
    }

    withName: 'ExpansionHunter|multi_expansionhunter' {
        cpus   = { 2 * task.attempt }
        memory = { 16.GB * task.attempt }
        publishDir = [
            path: { "${params.output_directory}" }
        ]
    }

    // Prioritization/aggregation steps that run longphase helper scripts.
    withName: 'longphase|multi_longphase|ngs_prio|multi_ngs_prio|snp_prio|multi_snp_prio|sv_prio|multi_sv_prio' {
        cpus   = { 2 * task.attempt }
        memory = { 32.GB * task.attempt }
        publishDir = [
            path: { "${params.output_directory}" },
            mode: 'copy'
        ]
    }

    // Build targeted BED intervals from phenotype-ranked genes.
    withName: 'phen2gene_filter|multi_phen2gene_filter' {
        cpus   = { 1 * task.attempt }
        memory = { 4.GB * task.attempt }
        time   = { 24.h }
        publishDir = [
            path: { "${params.output_directory}" }
        ]
    }

    // Download/stage GATK resource bundle for the light short-read path.
    withName: 'multi_prep_gatk' {
        cpus   = { 1 * task.attempt }
        memory = { 8.GB * task.attempt }
        time   = { 24.h }
        publishDir = [
            path: { "${params.output_directory}" }
        ]
    }

    withName: 'eh_filter|multi_eh_filter' {
        cpus   = { 1 * task.attempt }
        memory = { 4.GB * task.attempt }
        publishDir = [
            path: { "${params.output_directory}" }
        ]
    }

    withName: 'Rankscore_analysis|multi_rankscore' {
        cpus   = { 2 * task.attempt }
        memory = { 16.GB * task.attempt }
        publishDir = [
            path: { "${params.output_directory}" },
            mode: 'copy'
        ]
    }

    withName: 'phenotagger|multi_phenotagger' {
        cpus   = { 1 * task.attempt }
        memory = { 8.GB * task.attempt }
        publishDir = [
            path: { "${params.output_directory}" }
        ]
    }
}


profiles {
    // Default behavior: SLURM executor with Singularity containers.
    standard {
        process.executor = 'slurm'
        singularity.enabled = true
        singularity.autoMounts = true
        singularity.runOptions = "--bind ${params.annovar_host_path}:/annovar,${params.phenosv_host_path}:/PhenoSV/train_data"
        docker.enabled = false
    }

    // Explicit SLURM + Singularity profile (same backend as standard).
    slurm_singularity {
        process.executor = 'slurm'
        singularity.enabled = true
        singularity.autoMounts = true
        singularity.runOptions = "--bind ${params.annovar_host_path}:/annovar,${params.phenosv_host_path}:/PhenoSV/train_data"
        docker.enabled = false
    }

    // Local executor while still using Singularity images.
    local_singularity {
        process.executor = 'local'
        singularity.enabled = true
        singularity.autoMounts = true
        singularity.runOptions = "--bind ${params.annovar_host_path}:/annovar,${params.phenosv_host_path}:/PhenoSV/train_data"
        docker.enabled = false
    }

    // Local executor with Docker containers.
    local_docker {
        process.executor = 'local'
        docker.enabled = true
        docker.runOptions = "-v ${params.annovar_host_path}:/annovar -v ${params.phenosv_host_path}:/PhenoSV/train_data"
        singularity.enabled = false
    }
}

report {
	enabled=true
}

trace {
	enabled=true
}
