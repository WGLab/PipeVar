params {
	bam = null
	vcf = null
	annovar_txt = null
	annotated_snv = "no"
	annotated_sv = "no"
	annovar_sv_vcf = null
	pipeline_version = "0.5.0"
	out_prefix = "PipeVar"
	hpo = null
	light = null
	ref_fa = null
	gnomad = null
	gnomad_af_ad = null
	gnomad_af_ar = null
	inheritance_mode = "ml"
	include_clinvar_report = "yes"
	allow_unphased_comphet = "no"
	prioritize_sv_only = "no"
	rankscore = "0.50"
	rankscore_softwares = null
	rankvar = "0.05"
	phenosv_score = "0.50"
	common_sv_filter = "yes"
	common_sv_af = null
	common_sv_af_ad = null
	common_sv_af_ar = null
	common_sv_reciprocal_overlap = "0.5"
	common_sv_distance = "1000"
	common_sv_ins_distance = "500"
	common_sv_ins_identity = "0.5"
	denovo_filter = "no"
	denovo_role_column = "role"
	denovo_family_column = "family_id"
	denovo_vcf_sample_column = "vcf_sample"
	denovo_sv_min_reciprocal_overlap = "0.50"
	denovo_exclude_contigs = "MT,M,chrM,chrMT"
	gq = "20"
	ad = "15"
	nanocaller_dp = "20"
	mode = null
	type = "ont"
	help = false
	input_directory = null
	output_directory = launchDir
	gene = null
	note = null
	input_csv = null
	sex_column = "sex"
	phen2gene_filter = 500
	genome = "hg38"
	expansionhunter_variant_catalog = null
	target = null
	cnvnator = "yes"
	cnvnator_bin_size = 100
	truvari_shortread_refdist = 1000
	truvari_shortread_pctseq = 0
	truvari_shortread_pctsize = 0.5
	truvari_shortread_pctovl = 0.5
	truvari_shortread_sizemin = 50
	truvari_shortread_keep = "first"
	xtea = "no"
	mito = "no"
	mito_contig = "chrM"
	mito_min_vaf = "0.01"
	mito_min_depth = "50"
	mito_min_alt_reads = "5"
	mito_gui_min_af = "0.5"
	mito_gui_min_apogee2 = "0.5"
	mito_gui_min_mitotip = "12.66"
	hmtvar_data = null
	annovar_host_path = "${projectDir}/annovar"
	phenosv_host_path = "${projectDir}/PhenoSV_model"
	GPU = "no"
	gpu_backend = "singularity"
	gpu_cpus = 16
	gpu_cluster_options = "--gres=gpu:1"
	deepvariant_version = "1.9.0"
	deepvariant_max_forks = null
	phenotype_extractor = "phenotagger"
	phenogpt2_batch_size = 1
	phenogpt2_chunk_batch_size = 1
	phenogpt2_wc = 0
	phenogpt2_attn_implementation = "eager"
	phenogpt2_negation = "no"
	phenogpt2_max_forks = 1
	phenogpt2_model_host_path = null
	phenogpt2_negation_model_host_path = null
	phenogpt2_embedding_model_host_path = null
	phenogpt2_cache_host_path = null

}
def clean_light = params.light ? params.light.toString().trim().toLowerCase() : 'no'
def clean_type = params.type ? params.type.toString().trim().toLowerCase() : 'ont'
def clean_genome = params.genome ? params.genome.toString().trim().toLowerCase() : 'hg38'
def clean_GPU = params.GPU ? params.GPU.toString().trim().toLowerCase() : 'no'
def clean_gpu_backend = params.gpu_backend ? params.gpu_backend.toString().trim().toLowerCase() : 'singularity'
def gpu_container_options = {
	def backend = params.gpu_backend ? params.gpu_backend.toString().trim().toLowerCase() : 'singularity'
	backend == 'docker' ? '--gpus 1' : '--nv'
}
def phenogpt2_container_options = {
	def backend = params.gpu_backend ? params.gpu_backend.toString().trim().toLowerCase() : 'singularity'
	def model_path = params.phenogpt2_model_host_path?.toString()
	def negation = params.phenogpt2_negation ? params.phenogpt2_negation.toString().trim().toLowerCase() : 'no'
	def negation_model_path = params.phenogpt2_negation_model_host_path?.toString()
	def embedding_model_path = params.phenogpt2_embedding_model_host_path?.toString()
	def cache_path = params.phenogpt2_cache_host_path?.toString()
	if (!model_path) {
		return backend == 'docker' ? '--gpus 1' : '--nv'
	}
	if (backend == 'docker') {
		def options = "--gpus 1 -v ${model_path}:/opt/phenogpt2/models/phenogpt2:ro"
		if (negation == 'yes') {
			options += " -v ${negation_model_path}:/opt/phenogpt2/models/negation:ro"
			options += " -v ${embedding_model_path}:/opt/phenogpt2/models/embedding:ro"
		}
		return cache_path ? "${options} -v ${cache_path}:/opt/phenogpt2/cache:rw" : options
	}
	def options = "--nv --bind ${model_path}:/opt/phenogpt2/models/phenogpt2:ro"
	if (negation == 'yes') {
		options += " --bind ${negation_model_path}:/opt/phenogpt2/models/negation:ro"
		options += " --bind ${embedding_model_path}:/opt/phenogpt2/models/embedding:ro"
	}
	return cache_path ? "${options} --bind ${cache_path}:/opt/phenogpt2/cache:rw" : options
}
def clean_phenotype_extractor = params.phenotype_extractor ? params.phenotype_extractor.toString().trim().toLowerCase() : 'phenotagger'

if (!(clean_GPU in ['yes', 'no'])) {
	error "Invalid --GPU '${params.GPU}'. Use 'yes' or 'no'."
}
if (clean_GPU == 'yes' && !(clean_gpu_backend in ['singularity', 'docker'])) {
	error "Invalid --gpu_backend '${params.gpu_backend}'. Use 'singularity' or 'docker'."
}
if (!(clean_phenotype_extractor in ['phenotagger', 'phenogpt2'])) {
	error "Invalid --phenotype_extractor '${params.phenotype_extractor}'. Use 'phenotagger' or 'phenogpt2'."
}
if (clean_light == 'yes') {
	process {
		withName:'PhenoSV'{
			ext.args='--model PhenoSV-light '
		}
	}
	process {
		withName:'multi_phenosv'{
			ext.args='--model PhenoSV-light '
		}
	}
}

if (clean_type == 'ont') {
	process {
		withName:'nanocaller'{
			ext.args='--preset ont'
		}
	}
	process {
		withName:'multi_nanocaller'{
			ext.args='--preset ont'
		}
	}
	process {
		withName:'clair3|mito_clair3'{
			ext.args='--platform="ont" --model_path="/opt/models/ont"'
		}
	}
	process {
                withName:'multi_clair3|multi_mito_clair3'{
                        ext.args='--platform="ont" --model_path="/opt/models/ont"'
                }
        }
	process {
		withName:'cuteSV'{
			ext.args='--max_cluster_bias_INS 100 --diff_ratio_merging_INS 0.3 --max_cluster_bias_DEL 100 --diff_ratio_merging_DEL 0.3'
		}
	}
	process {
		withName:'NanoRepeat'{
			ext.args='ont'
		}
	}
	process {
                withName:'multi_nanorepeat'{
                        ext.args='ont'
                }
        }
	process {
		withName:'longphase|multi_longphase'{
			ext.args='--ont'
		}
	}
}


if (clean_type == 'pacbio' ) {
        process {
                withName:'nanocaller'{
			ext.args='--preset ccs'
        	}
	}
	process {
		withName:'multi_nanocaller'{
			ext.args='--preset ccs'
		}
	}
        process {
                withName:'clair3|mito_clair3'{
			ext.args='--platform="hifi" --model_path="/opt/models/hifi"'
        	}
	}
	process {
                withName:'multi_clair3|multi_mito_clair3'{
                        ext.args='--platform="hifi" --model_path="/opt/models/hifi"'
                }
        }
        process {
                withName:'cuteSV'{
			ext.args='--max_cluster_bias_INS 1000 --diff_ratio_merging_INS 0.9 --max_cluster_bias_DEL 1000 --diff_ratio_merging_DEL	0.5'
        	}
	}
	process {
		withName:'NanoRepeat'{
			ext.args='hifi'
		}
	}
	process {
                withName:'multi_nanorepeat'{
                        ext.args='hifi'
                }
        }
	process {
		withName:'longphase|multi_longphase'{
			ext.args=''
		}
	}

}



process {
    errorStrategy = 'retry'
    maxRetries = 3

    // Combine 'nanocaller' and 'multi_nanocaller'
    withName: 'nanocaller|multi_nanocaller' {
        cpus   = { 8 * task.attempt }
        memory = { 32.GB * task.attempt }
        time   = { 48.h }
        publishDir = [
            path: { "${params.output_directory}" }
        ]
    }

    withName: 'PhenoSV|multi_phenosv' {
        cpus   = { 1 * task.attempt }
        memory = { 8.GB * task.attempt }
        time   = { 48.h }
        publishDir = [
            path: { "${params.output_directory}" },
            mode: 'copy'
        ]

    }

    withName: 'ANNOVAR|multi_annovar' {
        cpus   = { 2 * task.attempt }
        memory = { 16.GB * task.attempt }
        time   = { 24.h }
        publishDir = [
            path: { "${params.output_directory}" },
            pattern: "*{txt}"
        ]
    }

    withName: 'Phen2gene|multi_phen2gene' {
        cpus   = { 1 * task.attempt }
        memory = { 4.GB * task.attempt }
        time   = { 4.h }
        publishDir = [
            path: { "${params.output_directory}" }
        ]
    }

    withName: 'clair3|multi_clair3' {
        cpus   = { 8 * task.attempt }
        memory = { 32.GB * task.attempt }
        time   = { 72.h }
        publishDir = [
            path: { "${params.output_directory}" }
        ]

    }
    withName: 'mito_clair3|multi_mito_clair3' {
        cpus   = { 2 * task.attempt }
        memory = { 8.GB * task.attempt }
        time   = { 8.h }
        publishDir = [
            path: { "${params.output_directory}" }
        ]

    }
    withName: 'mito_clair3_postprocess|multi_mito_clair3_postprocess' {
        cpus   = { 1 * task.attempt }
        memory = { 4.GB * task.attempt }
        time   = { 4.h }
        publishDir = [
            path: { "${params.output_directory}" }
        ]

    }
    withName: 'NanoRepeat|multi_nanorepeat' {
        cpus   = { 2 * task.attempt }
        memory = { 16.GB * task.attempt }
        time   = { 72.h }
        publishDir = [
            path: { "${params.output_directory}" }
        ]
    }

    withName: 'RankVar|RankVarNanoCaller|multi_rankvar|multi_rankvar_nanocaller' {
        cpus   = { 1 * task.attempt }
        memory = { 8.GB * task.attempt }
        time   = { 8.h }
        publishDir = [
            path: { "${params.output_directory}" },
            mode: 'copy'
        ]
    }

    withName: 'RankVarNanoCaller|multi_rankvar_nanocaller' {
        ext.nanocaller_dp = params.nanocaller_dp
        ext.rankvar_script = '/opt/RankVar/RankVar_nanocaller.py'
    }

    withName: 'sniffles|multi_sniffles' {
        cpus   = { 2 * task.attempt }
        memory = { 16.GB * task.attempt }
        time   = { 24.h }
        publishDir = [
            path: { "${params.output_directory}" }
        ]

    }

    withName: 'SURVIVOR|multi_survivor' {
        cpus   = { 1 * task.attempt }
        memory = { 4.GB * task.attempt }
        time   = { 2.h }
        publishDir = [
            path: { "${params.output_directory}" }
        ]
    }

    withName: 'truvari' {
        cpus   = { 1 * task.attempt }
        memory = { 4.GB * task.attempt }
        time   = { 4.h }
        publishDir = [
            path: { "${params.output_directory}" }
        ]
    }

    withName: 'cuteSV' {
        cpus   = { 2 * task.attempt }
        memory = { 16.GB * task.attempt }
        time   = { 48.h }
        publishDir = [
            path: { "${params.output_directory}" }
        ]
    }

    withName: 'Manta|multi_manta' {
        cpus   = { 4 * task.attempt }
        memory = { 32.GB * task.attempt }
        time   = { 48.h }
        publishDir = [
            path: { "${params.output_directory}" }
        ]
    }

    withName: 'normalize_shortread_alignment|multi_normalize_shortread_alignment' {
        cpus   = { 2 * task.attempt }
        memory = { 8.GB * task.attempt }
        time   = { 24.h }
    }

    withName: 'CNVnator|multi_cnvnator' {
        cpus   = { 2 * task.attempt }
        memory = { 32.GB * task.attempt }
        time   = { 72.h }
        publishDir = [
            path: { "${params.output_directory}" },
            pattern: "*_cnvnator.{tab,vcf}"
        ]
    }

    withName: 'xtea|multi_xtea' {
        cpus   = { 8 * task.attempt }
        memory = { 32.GB * task.attempt }
        time   = { 72.h }
        publishDir = [
            path: { "${params.output_directory}" },
            pattern: "*_xtea*"
        ]
    }

    withName: 'merge_shortread_sv_callers|multi_merge_shortread_sv_callers' {
        cpus   = { 1 * task.attempt }
        memory = { 4.GB * task.attempt }
        time   = { 4.h }
        publishDir = [
            path: { "${params.output_directory}" },
            pattern: "*.shortread_sv.merged.vcf"
        ]
    }

    withName: 'truvari_shortread_sv_merge|multi_truvari_shortread_sv_merge' {
        cpus   = { 1 * task.attempt }
        memory = { 8.GB * task.attempt }
        time   = { 8.h }
        ext.args = "--refdist ${params.truvari_shortread_refdist} --pctseq ${params.truvari_shortread_pctseq} --pctsize ${params.truvari_shortread_pctsize} --pctovl ${params.truvari_shortread_pctovl} --sizemin ${params.truvari_shortread_sizemin} --keep ${params.truvari_shortread_keep}"
        publishDir = [
            path: { "${params.output_directory}" },
            pattern: "*.shortread_sv*.vcf",
            mode: 'copy'
        ]
    }

    withName: 'haplotypecaller|multi_haplotypecaller' {
        cpus   = { 2 * task.attempt }
        memory = { 16.GB * task.attempt }
        time   = { 48.h }
        publishDir = [
            path: { "${params.output_directory}" }
        ]
    }

    withName: 'deepvariant|multi_deepvariant' {
        cpus   = { clean_GPU == 'yes' ? params.gpu_cpus as int : 16 * task.attempt }
        memory = { 64.GB * task.attempt }
        time   = { 72.h }
        maxForks = params.deepvariant_max_forks ? params.deepvariant_max_forks as int : 1000000
        publishDir = [
            path: { "${params.output_directory}" }
        ]
    }

    withName: 'ANNOVAR_SV|multi_annovar_sv' {
        cpus   = { 1 * task.attempt }
        memory = { 4.GB * task.attempt }
        time   = { 8.h }
        publishDir = [
            path: { "${params.output_directory}" }
        ]
    }

    withName: 'common_sv_filter|multi_common_sv_filter' {
        cpus   = { 1 * task.attempt }
        memory = { 4.GB * task.attempt }
        time   = { 4.h }
        publishDir = [
            path: { "${params.output_directory}" },
            pattern: "*.common_sv_*",
            mode: 'copy'
        ]
    }

    withName: 'multi_denovo_snv_filter|multi_denovo_snv_vcf_filter|multi_denovo_sv_filter' {
        cpus   = { 1 * task.attempt }
        memory = { 4.GB * task.attempt }
        time   = { 4.h }
        publishDir = [
            path: { "${params.output_directory}" },
            pattern: "{*.denovo.*,denovo.*.summary.tsv,denovo.*.bindings.tsv}",
            mode: 'copy'
        ]
    }

    withName: 'ExpansionHunter|multi_expansionhunter' {
        cpus   = { 2 * task.attempt }
        memory = { 16.GB * task.attempt }
        time   = { 12.h }
        publishDir = [
            path: { "${params.output_directory}" }
        ]
    }

    // LongPhase performs BAM-backed phasing/haplotagging and remains heavier than final VCF prioritization.
    withName: 'longphase|multi_longphase' {
        cpus   = { 4 * task.attempt }
        memory = { 32.GB * task.attempt }
        time   = { 24.h }
        publishDir = [
            path: { "${params.output_directory}" },
            mode: 'copy'
        ]
    }

    // Terminal prioritization outputs can be moved out of work after successful publication.
    withName: 'ngs_prio|multi_ngs_prio|snp_prio|multi_snp_prio|sv_prio|multi_sv_prio' {
        cpus   = { 1 * task.attempt }
        memory = { 8.GB * task.attempt }
        time   = { 8.h }
        publishDir = [
            path: { "${params.output_directory}" },
            mode: 'copy'
        ]
    }

    withName: 'variant_html_report_no_repeat|variant_html_report|variant_html_report_with_mito|multi_variant_html_report_no_repeat|multi_variant_html_report|multi_variant_html_report_with_mito|multi_variant_html_report_with_repeat|multi_variant_html_report_with_repeat_and_mito' {
        cpus   = { 1 * task.attempt }
        memory = { 4.GB * task.attempt }
        time   = { 2.h }
        publishDir = [
            path: { "${params.output_directory}" },
            mode: 'copy'
        ]
    }

    // Build targeted BED intervals from phenotype-ranked genes.
    withName: 'phen2gene_filter|multi_phen2gene_filter' {
        cpus   = { 1 * task.attempt }
        memory = { 4.GB * task.attempt }
        time   = { 2.h }
        publishDir = [
            path: { "${params.output_directory}" }
        ]
    }

    // Download/stage GATK resource bundle for the light short-read path.
    withName: 'multi_prep_gatk' {
        cpus   = { 1 * task.attempt }
        memory = { 8.GB * task.attempt }
        time   = { 24.h }
        publishDir = [
            path: { "${params.output_directory}" }
        ]
    }

    withName: 'eh_filter|multi_eh_filter' {
        cpus   = { 1 * task.attempt }
        memory = { 4.GB * task.attempt }
        time   = { 1.h }
        publishDir = [
            path: { "${params.output_directory}" }
        ]
    }

    withName: 'mito_prep_mutect2|multi_mito_prep_mutect2' {
        cpus   = { 4 * task.attempt }
        memory = { 8.GB * task.attempt }
        time   = { 8.h }
        publishDir = [
            path: { "${params.output_directory}" },
            pattern: "*.mito.dup_metrics.txt",
            mode: 'copy'
        ]
    }

    withName: 'mito_mutect2|multi_mito_mutect2' {
        cpus   = { 1 * task.attempt }
        memory = { 8.GB * task.attempt }
        time   = { 4.h }
        publishDir = [
            path: { "${params.output_directory}" }
        ]
    }

    withName: 'mito_annotation|multi_mito_annotation' {
        cpus   = { 1 * task.attempt }
        memory = { 4.GB * task.attempt }
        time   = { 2.h }
        publishDir = [
            path: { "${params.output_directory}" },
            mode: 'copy'
        ]
    }

    withName: 'mito_prio|multi_mito_prio' {
        cpus   = { 1 * task.attempt }
        memory = { 4.GB * task.attempt }
        time   = { 2.h }
        publishDir = [
            path: { "${params.output_directory}" },
            mode: 'copy'
        ]
    }

    withName: 'Rankscore_analysis|Rankscore_analysis_preannotated|multi_rankscore|multi_rankscore_preannotated' {
        cpus   = { 1 * task.attempt }
        memory = { 8.GB * task.attempt }
        time   = { 4.h }
        publishDir = [
            path: { "${params.output_directory}" },
            mode: 'copy'
        ]
    }

    withName: 'phenotagger|multi_phenotagger' {
        cpus   = { 1 * task.attempt }
        memory = { 8.GB * task.attempt }
        time   = { 4.h }
        publishDir = [
            path: { "${params.output_directory}" }
        ]
	}

    withName: 'phenogpt2|multi_phenogpt2' {
        cpus   = { params.gpu_cpus as int }
        memory = { 64.GB * task.attempt }
        time   = { 12.h }
        maxForks = params.phenogpt2_max_forks ? params.phenogpt2_max_forks as int : 1
        publishDir = [
            path: { "${params.output_directory}" }
        ]
    }
}

if (clean_GPU == 'yes') {
    process {
        withName: 'deepvariant|multi_deepvariant' {
            containerOptions = gpu_container_options
            clusterOptions = params.gpu_cluster_options ? params.gpu_cluster_options.toString() : ''
        }
        withName: 'phenogpt2|multi_phenogpt2' {
            containerOptions = phenogpt2_container_options
            clusterOptions = params.gpu_cluster_options ? params.gpu_cluster_options.toString() : ''
        }
    }
}


profiles {
    // Default behavior: SLURM executor with Singularity containers.
    standard {
		params.gpu_backend = 'singularity'
        process.executor = 'slurm'
        singularity.enabled = true
        singularity.autoMounts = true
        singularity.runOptions = "--bind ${params.annovar_host_path}:/annovar,${params.phenosv_host_path}:/PhenoSV/train_data"
        docker.enabled = false
    }

    // Explicit SLURM + Singularity profile (same backend as standard).
    slurm_singularity {
		params.gpu_backend = 'singularity'
        process.executor = 'slurm'
        singularity.enabled = true
        singularity.autoMounts = true
        singularity.runOptions = "--bind ${params.annovar_host_path}:/annovar,${params.phenosv_host_path}:/PhenoSV/train_data"
        docker.enabled = false
    }

    // Local executor while still using Singularity images.
    local_singularity {
		params.gpu_backend = 'singularity'
        process.executor = 'local'
        singularity.enabled = true
        singularity.autoMounts = true
        singularity.runOptions = "--bind ${params.annovar_host_path}:/annovar,${params.phenosv_host_path}:/PhenoSV/train_data"
        docker.enabled = false
    }

    // Local executor with Docker containers.
    local_docker {
		params.gpu_backend = 'docker'
        process.executor = 'local'
        docker.enabled = true
        docker.runOptions = "-v ${params.annovar_host_path}:/annovar -v ${params.phenosv_host_path}:/PhenoSV/train_data"
        singularity.enabled = false
    }
}

report {
	enabled=true
}

trace {
	enabled=true
}
